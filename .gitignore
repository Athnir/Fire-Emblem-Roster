# electron-builder output (the packaged .exe and its unpacked folder) — large binaries, not source,
# regenerated any time with `npm run dist:win`.
release

# Copyrighted character art — see ART_ASSETS.md. Kept out of the repo entirely; drop the whole
# public/art/ folder back in locally to restore portraits, or delete it before sharing/pushing.
public/art/

# Copyrighted skill/item icons extracted from the game's own Icon.bch — same reasoning as
# public/art/ above. See scripts/import_skill_icons.py.
public/skills/

# Dumped game files (romfs, ROM images, anything read from the user's own copies) — only data
# derived from them by the generators in scripts/ goes in the repo. See CLAUDE.md.
data-raw/
*.smc
*.sfc
*.gba
*.3ds
*.cia

